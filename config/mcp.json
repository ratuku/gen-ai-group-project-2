{
  "mcpServers": {
    "filesystem": {
      "command": "node",
      "args": [
        "${configDir}/../node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "${workspaceRoot}"
      ]
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "timeoutSeconds": 60
    },
    "rag": {
      "command": "${pythonExecutable}",
      "args": [
        "-m",
        "rag_server.server",
        "--store",
        "${configDir}/../rag_server/artifacts/chroma"
      ],
      "timeoutSeconds": 120
    }
  }
}
